# =============================================
# PahamIn Backend — Environment Configuration
# =============================================

# --- App ---
APP_NAME="PahamIn API"
APP_ENV=development
DEBUG=true
SECRET_KEY=GANTI_DENGAN_RANDOM_STRING_MINIMAL_32_KARAKTER
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database ---
POSTGRES_USER=pahamin
POSTGRES_PASSWORD=pahamin_secret
POSTGRES_DB=pahamin_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pahamin:pahamin_secret@db:5432/pahamin_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI (Google Gemini) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# --- Image Generation ---
# Options: "gemini" (default, Google Gemini Flash Image) | "pollinations" (free FLUX tanpa API key) | "huggingface"
IMAGE_GENERATION_PROVIDER=gemini
# HuggingFace (opsional, hanya jika IMAGE_GENERATION_PROVIDER="huggingface")
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Storage (Supabase Storage / Local) ---
# Jika dikosongkan, backend otomatis beralih ke local storage
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=presentation-assets

